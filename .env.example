# ============================================================
#  ORGANIC PESTICIDE - KRISHNA WORLDWIDE
#  .env.example  (template - DO NOT put real secrets in the repo)
# ============================================================
#  HOW TO USE:
#   1. Create a file named `.env` OUTSIDE the web root, e.g. one level
#      above this project (so it is NOT web-accessible). Example:
#
#        /home/<user>/
#          .env                      <- put real keys here
#          public_html/              <- the website (this project)
#
#   2. Copy the variable names below into that `.env` and fill in your
#      real values. The backend loads them automatically via getenv().
#
#   3. NEVER commit `.env` or paste real keys into chat/source files.
#   4. System environment variables on your host OVERRIDE .env values.
#
#  NOTE: These are PLACEHOLDER examples. Replace with real values.
# ============================================================

# ---- App ----
APP_ENV=production
# SITE_URL=https://www.yourdomain.com

# ---- Orders & logs (optional - move ABOVE web root for extra safety) ----
# ORDERS_DIR=/home/user/private-data/orders
# LOGS_DIR=/home/user/private-data/logs

# ---- Razorpay (PRIMARY gateway) ----
# RAZORPAY_ENV=test          # test | live
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_CALLBACK_URL=https://www.yourdomain.com/backend/razorpay/verify.php

# ---- Paytm (fallback gateway) ----
# PAYTM_ENV=TEST             # TEST | PROD
# PAYTM_MERCHANT_ID=
# PAYTM_MERCHANT_KEY=
# PAYTM_CALLBACK_URL=https://www.yourdomain.com/backend/paytm/paytm-response.php

# ---- Cashfree (additional gateway) ----
# CASHFREE_ENV=test          # test | prod
# CASHFREE_CLIENT_ID=
# CASHFREE_CLIENT_SECRET=
# CASHFREE_CALLBACK_URL=https://www.yourdomain.com/backend/cashfree/verify.php

# ---- Shiprocket (logistics: shipping + label + tracking) ----
# Prefer the long-lived Token key (Shiprocket Token API / SysOps).
# SHIPROCKET_TOKEN_KEY=
# Or use email + password (auto-login + cached token).
# SHIPROCKET_EMAIL=
# SHIPROCKET_PASSWORD=
# Optional admin password for /backend/shiprocket/admin.php
# SHIPROCKET_ADMIN_KEY=

# ---- Payment gateway security ----
# If a gateway is switched to live/prod but no real credentials are set,
# the app will fail-fast (500) instead of processing with bogus keys.
