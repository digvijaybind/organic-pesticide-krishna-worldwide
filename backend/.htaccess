# ============================================================
#  ORGANIC PESTICIDE - BACKEND PROTECTION (Apache 2.4)
#  Security rules for the /backend directory.
#
#  Best practice:
#   - Place sensitive config OUTSIDE the public web root
#   - Never allow direct browser access to config/, orders/, logs/
# ============================================================

Options -Indexes

# ---- Block direct access to sensitive subdirectories (mod_rewrite, reliable) ----
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(config|orders|logs)/ - [F,L]
</IfModule>

# ---- Deny access to dotfiles (e.g. .htaccess) - Apache 2.4 ----
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# ---- Deny direct access to internal PHP library files ----
# (These are only ever included server-side via require(), never served.)
<FilesMatch "^(Paytm\.class|razorpay-curl)\.php$">
    Require all denied
</FilesMatch>

# ---- Legacy fallback for Apache 2.2 (harmless on 2.4) ----
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>

# Note: api/*.php, paytm/*.php and razorpay/*.php endpoint entry points
# remain reachable via HTTP as intended; internal classes/config are blocked.
